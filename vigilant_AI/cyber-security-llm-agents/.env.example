LLM_WORKING_FOLDER=llm_working_folder

# Caldera (optional)
CALDERA_SERVER=http://localhost:8888
CALDERA_API_KEY=<CALDERA_API_KEY>

# LLM configuration
OPENAI_MODEL_NAME=<MODEL_NAME>
OPENAI_API_KEY=<YOUR_API_KEY>

# API Server Port (local only; Railway injects PORT automatically)
API_PORT=5000

# Optional - Only required if you plan to run the integrated Web and/or FTP server
WEB_SERVER_PORT=8800
FTP_SERVER_ADDRESS=<IP:PORT>
FTP_SERVER_USER=user
FTP_SERVER_PASS=changeme

